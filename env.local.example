ENABLE_PROOF_GEN_ENDPOINT=false

# Nonce-store Redis URL: scheme/AUTH/TLS in one value (redis://, redis://:pw@host, rediss://).
REDIS_URL=redis://127.0.0.1:6380

# Per-command and connect deadline for Redis, in milliseconds.
REDIS_COMMAND_TIMEOUT_MS=2000

# Base URL of the World ID gateway exposing GET /is-valid-root. REQUIRED — the
# service refuses to start if unset. Point at a real gateway; it must NOT be this
# service's own bind port (8080), or every verify would self-404.
GATEWAY_URL=http://127.0.0.1:8081

# Trusted JWT public keys for POST /api/v4/verify. REQUIRED — the service refuses
# to start if unset, empty, or holding an invalid key, so the verify route is
# never served unauthenticated. A JSON object mapping each calling service's name
# (the JWT `sub`) to its ES256 public key(s) in PEM SPKI form. `previous` is
# optional and exists only to bridge a key rotation (both keys are accepted).
# Single-line JSON; embed PEM newlines as \n:
JWT_TRUSTED_KEYS={"service-a":{"current":"-----BEGIN PUBLIC KEY-----\nMFkw...==\n-----END PUBLIC KEY-----\n","previous":"-----BEGIN PUBLIC KEY-----\nMFkw...==\n-----END PUBLIC KEY-----\n"},"service-b":{"current":"-----BEGIN PUBLIC KEY-----\nMFkw...==\n-----END PUBLIC KEY-----\n"}}
